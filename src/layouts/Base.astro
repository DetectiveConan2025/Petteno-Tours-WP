---
/**
 * Layout comune: <head> con SEO/social/JSON-LD, header, footer, script.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getAzienda, getHero, waHref } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const a = await getAzienda();
const hero = await getHero();
const firstHero = hero.immagini.find((s) => s.immagine)?.immagine;

const siteName = 'Pettenò Tours';
const title = Astro.props.title
  ? `${Astro.props.title} — ${siteName}`
  : `${siteName} — Noleggio pullman con conducente in Veneto`;
const description = Astro.props.description ?? a.seoDescrizione;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImage = firstHero ? new URL(firstHero, Astro.site ?? Astro.url).href : undefined;
const isHome = Astro.url.pathname === '/';
const wa = waHref(a.whatsapp);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: a.ragioneSociale,
  description,
  url: new URL('/', Astro.site ?? Astro.url).href,
  telephone: a.telMobile,
  email: a.email,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: a.via,
    postalCode: a.cap,
    addressLocality: a.citta,
    addressRegion: a.provincia,
    addressCountry: 'IT',
  },
};
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1f63c8" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="it_IT" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&display=swap"
    />
    {isHome && firstHero && <link rel="preload" as="image" href={firstHero} fetchpriority="high" />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {wa && (
      <a href={wa} class="wa-float" target="_blank" rel="noopener noreferrer" aria-label="Scrivici su WhatsApp">
        <Icon name="whatsapp" strokeWidth={1.8} />
      </a>
    )}

    <script src="../scripts/main.js"></script>
  </body>
</html>
