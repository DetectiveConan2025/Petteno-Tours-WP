---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Fleet from '../components/Fleet.astro';
import RoutesTeaser from '../components/RoutesTeaser.astro';
import About from '../components/About.astro';
import CtaBand from '../components/CtaBand.astro';
import { getNavLinks } from '../lib/site';

// Le sezioni si accendono/spengono dal pannello (/keystatic).
const { servizi, flotta, rotte, chiSiamo } = await getNavLinks();
---
<Base>
  <Hero />
  {servizi.mostra && <Services />}
  {flotta.mostra && <Fleet />}
  {rotte.mostra && <RoutesTeaser />}
  {chiSiamo.mostra && <About />}
  <CtaBand />
</Base>
