---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata">
  <section class="section notfound">
    <div class="wrap">
      <span class="kicker">Errore 404</span>
      <h1 class="h2">Questa pagina non esiste</h1>
      <p class="lead">Forse il link è cambiato. Torna alla home o scrivici per un preventivo.</p>
      <a href="/" class="btn btn-primary">Torna alla home</a>
    </div>
  </section>
</Base>
