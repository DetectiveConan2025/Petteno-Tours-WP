---
import { getAzienda, getNavLinks, telHref, addressFull, URLS } from '../lib/site';
const a = await getAzienda();
const { servizi, flotta, rotte, chiSiamo } = await getNavLinks();

const cols: { title: string; links: { label: string; href: string }[] }[] = [];
if (servizi.mostra) {
  cols.push({
    title: 'Servizi',
    links: servizi.elenco.slice(0, 5).map((s) => ({ label: s.titolo, href: URLS.anchor('#servizi') })),
  });
}
const azienda: { label: string; href: string }[] = [];
if (chiSiamo.mostra) azienda.push({ label: 'Chi siamo', href: URLS.anchor('#chi-siamo') });
if (flotta.mostra) azienda.push({ label: 'La flotta', href: URLS.anchor('#flotta') });
if (rotte.mostra) azienda.push({ label: 'Rotte scolastiche', href: URLS.rotte });
azienda.push({ label: 'Contatti', href: URLS.contatti });
cols.push({ title: 'Azienda', links: azienda });

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <div class="brand">
        <img src="/images/logo.png" alt="Pettenò Tours" class="footer-logo" width="240" height="80" loading="lazy" />
      </div>
      <p>Noleggio autobus con conducente per gruppi, scuole e aziende. In viaggio in Italia e in Europa, dal Veneto.</p>
    </div>

    {cols.map((col) => (
      <nav class="footer-col" aria-label={col.title}>
        <h3>{col.title}</h3>
        <ul>
          {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    ))}

    <div class="footer-col">
      <h3>Contatti</h3>
      <ul>
        {a.telMobile && <li><a href={telHref(a.telMobile)}>{a.telMobile}</a></li>}
        {a.telFisso && <li><a href={telHref(a.telFisso)}>{a.telFisso}</a></li>}
        {a.email && <li><a href={`mailto:${a.email}`}>{a.email}</a></li>}
        <li>{addressFull(a)}</li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>© <span id="footer-year">{year}</span> {a.ragioneSociale} — P.IVA {a.piva}</p>
    <p>{addressFull(a)}</p>
  </div>
</footer>
