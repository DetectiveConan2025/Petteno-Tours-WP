---
import Icon from './Icon.astro';
import { getAzienda, getContatti, telHref, addressShort } from '../lib/site';
const a = await getAzienda();
const c = await getContatti();

const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const cards = [
  a.telMobile && { label: 'Telefono', value: a.telMobile, href: telHref(a.telMobile), icon: 'telefono' },
  a.telFisso && { label: 'Telefono fisso', value: a.telFisso, href: telHref(a.telFisso), icon: 'telefono' },
  a.email && { label: 'Email', value: a.email, href: `mailto:${a.email}`, icon: 'email' },
  { label: 'Sede', value: addressShort(a), href: a.mapsUrl, icon: 'sede', external: true },
].filter(Boolean) as { label: string; value: string; href: string; icon: string; external?: boolean }[];
---
<section id="contatti" class="contact">
  <div class="wrap contact-grid">
    <div class="contact-intro">
      <span class="kicker kicker-light">{c.kicker}</span>
      <h1 class="h2">{c.titolo}</h1>
      <p>{c.intro}</p>

      <ul class="contact-cards">
        {cards.map((card) => (
          <li>
            <span class="ccard-icon"><Icon name={card.icon} /></span>
            <div>
              <span class="ccard-label">{card.label}</span>
              <a
                href={card.href}
                class="ccard-value"
                {...(card.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >{card.value}</a>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <form class="contact-form" id="preventivo" novalidate data-fallback-email={a.email}>
      <div class="field">
        <label for="nome">Nome e cognome <span class="req" aria-hidden="true">*</span></label>
        <input id="nome" name="nome" type="text" autocomplete="name" required maxlength="120" />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
        </div>
        <div class="field">
          <label for="telefono">Telefono <span class="req" aria-hidden="true">*</span></label>
          <input id="telefono" name="telefono" type="tel" autocomplete="tel" required maxlength="40" />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="persone">Numero di persone</label>
          <input id="persone" name="persone" type="number" min="1" max="999" inputmode="numeric" />
        </div>
        <div class="field">
          <label for="data">Data di partenza</label>
          <div class="date-wrap">
            <input id="data" name="data" type="date" />
            <Icon name="calendario" class="date-icon" strokeWidth={1.8} />
          </div>
        </div>
      </div>
      <div class="field">
        <label for="messaggio">Dove andate e per quale occasione? <span class="req" aria-hidden="true">*</span></label>
        <textarea id="messaggio" name="messaggio" rows="4" maxlength="4000" placeholder="Es. Gita scolastica Venezia – Firenze, andata e ritorno in giornata" required></textarea>
      </div>

      <!-- Trappola anti-spam: le persone non la vedono, i bot la compilano. -->
      <div class="hp-field" aria-hidden="true">
        <label for="sito_web">Lascia vuoto questo campo</label>
        <input id="sito_web" name="sito_web" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {turnstileKey && (
        <>
          <div class="cf-turnstile" data-sitekey={turnstileKey} data-language="it"></div>
          <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        </>
      )}

      <button type="submit" class="btn btn-primary form-submit">Invia richiesta</button>
      <p class="form-note"><span class="req" aria-hidden="true">*</span> Campi obbligatori</p>
      <p class="form-privacy">
        Inviando la richiesta dichiari di aver letto l'<a href="/privacy/">informativa privacy</a>.
        I dati non vengono salvati sul sito: ci arrivano soltanto via email, per risponderti.
      </p>
      <p class="form-hint" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
