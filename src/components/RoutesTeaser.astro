---
import Icon from './Icon.astro';
import { getRotte, URLS } from '../lib/site';
const r = await getRotte();
const n = r.linee.filter((l) => l.nome.trim()).length;
---
<section id="rotte" class="section routes-teaser-section">
  <div class="wrap routes-teaser">
    <div class="routes-teaser-copy reveal">
      <span class="kicker">{r.kicker}</span>
      <h2>{r.titolo}</h2>
      <p class="lead">{r.lead}</p>
    </div>
    <div class="routes-teaser-actions reveal">
      {n > 0 && <span class="pill">{n === 1 ? '1 linea attiva' : `${n} linee attive`}</span>}
      <a href={URLS.rotte} class="btn btn-primary">{r.cta} <Icon name="freccia" strokeWidth={2} /></a>
    </div>
  </div>
</section>
