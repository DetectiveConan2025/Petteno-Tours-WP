---
import Icon from './Icon.astro';
import { getHero, URLS } from '../lib/site';
const h = await getHero();
const slides = h.immagini.filter((s) => s.immagine);
---
<section id="top" class="hero" aria-label="Pettenò Tours — noleggio pullman">
  <!-- Slideshow fotografico in background (N immagini, crossfade via JS) -->
  <div class="slides" data-slideshow aria-hidden="true">
    {slides.map((s, i) => (
      <div
        class:list={['slide', { 'is-active': i === 0 }]}
        style={`background-image: url('${s.immagine}')`}
        role="img"
        aria-label={s.alt || 'Pullman Pettenò Tours'}
      />
    ))}
  </div>

  <div class="overlay" aria-hidden="true"></div>

  <div class="wrap hero-content">
    <div class="hero-copy">
      {h.badge && <span class="pill pill-light">{h.badge}</span>}
      <h1>
        {h.titoloRiga1}<br />
        {h.titoloPrima} <span class="accent-w">{h.titoloAccento}</span>{h.titoloDopo}
      </h1>
      <p class="lead">{h.lead}</p>
      <div class="hero-actions">
        <a href={URLS.contatti} class="btn btn-white">{h.cta1}</a>
        <a href={URLS.anchor('#flotta')} class="btn btn-ghost-white">{h.cta2}</a>
      </div>
    </div>
  </div>

  <a href="#servizi" class="scroll-down" aria-label="Scorri alla sezione Servizi">
    <Icon name="giu" size={30} strokeWidth={2.5} />
  </a>
</section>
